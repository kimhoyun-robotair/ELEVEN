#!/usr/bin/env bash
set -eo pipefail
project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
unset PYTHONPATH LD_LIBRARY_PATH AMENT_PREFIX_PATH CMAKE_PREFIX_PATH COLCON_PREFIX_PATH
unset PYTHONHOME VIRTUAL_ENV CONDA_PREFIX
source /opt/ros/jazzy/setup.bash
export PYTHONDONTWRITEBYTECODE=1
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-73}" RMW_IMPLEMENTATION=rmw_fastrtps_cpp
export ROS_LOG_DIR="$project_root/.runtime/ros_log"
mkdir -p "$ROS_LOG_DIR"
cd "$project_root"
action="${1:-help}"
shift || true
if [[ "$action" != build && -f "$project_root/install/local_setup.bash" ]]; then
  source "$project_root/install/local_setup.bash"
fi
case "$action" in
  build) exec /usr/bin/python3 -m colcon build --base-paths src --packages-select aprl_robot_sim nero_description scout_twin_description --cmake-args -DPython3_EXECUTABLE=/usr/bin/python3 --symlink-install "$@" ;;
  teleop|arm_teleop|route|verify) PYTHONPATH="$project_root/src/aprl_robot_sim:$PYTHONPATH" exec /usr/bin/python3 -m "aprl_robot_sim.$action" "$@" ;;
  rviz)
    robot="${ROBOT:-amr}"
    if [[ "${1:-}" == --robot ]]; then
      robot="${2:-}"
      [[ -n "$robot" ]] || { echo 'Usage: scripts/ros rviz --robot amr|locomanipulator|scout' >&2; exit 2; }
      shift 2
    fi
    case "$robot" in
      amr|locomanipulator|scout) ;;
      *) echo "Unknown robot: $robot" >&2; exit 2 ;;
    esac
    exec rviz2 -d "$project_root/src/aprl_robot_sim/rviz/$robot.rviz" --ros-args -p use_sim_time:=true "$@" ;;
  *) exec ros2 "$action" "$@" ;;
esac
