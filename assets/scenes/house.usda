#usda 1.0
(
    defaultPrim = "World"
    doc = "Blender-authored multi-floor testbed; run isaac/run.py for active elevators. Prepared with OpenUSD; Isaac Sim 5.1 runtime validation is a separate step."
    endTimeCode = 240
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @house_geometry.usdc@
    ]
    timeCodesPerSecond = 60
    upAxis = "Z"
)

over "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        custom string testbed:targetIsaacSim = "5.1.0"
    }

