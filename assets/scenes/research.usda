#usda 1.0
(
    defaultPrim = "World"
    doc = "Blender-authored multi-floor testbed; run isaac/run.py for active elevators. Prepared with OpenUSD; Isaac Sim 5.1 runtime validation is a separate step."
    endTimeCode = 240
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @research_geometry.usdc@
    ]
    timeCodesPerSecond = 60
    upAxis = "Z"
)

over "World"
{
    def PhysicsScene "PhysicsScene"
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        custom string testbed:targetIsaacSim = "5.1.0"
    }

    over "Elevators"
    {
        over "E2"
        {
            custom int testbed:currentFloor = 0
            custom double testbed:doorTravel = 0.72
            custom double[] testbed:floorHeights = [0, 4, 8, 12, 16, 20]
            custom string[] testbed:floorLabels = ["B1", "1F", "2F", "3F", "4F", "RF"]
            custom string testbed:label = "E2"
            custom string testbed:state = "IDLE"
            custom token testbed:type = "opaque"

            over "E2_Pit"
            {
                over "E2_PitBufferHead"
                {
                    over "E1_PitBufferHead_Mesh" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "none"
                        bool physics:collisionEnabled = 1
                    }
                }

                over "E2_PitEnd"
                {
                    over "E1_PitEnd_Mesh" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
                    )
