    over "Lighting"
    {
        def DomeLight "Environment"
        {
            color3f inputs:color = (0.79, 0.87, 1)
            float inputs:intensity = 420
        }

        def DistantLight "Sun"
        {
            float inputs:angle = 0.7
            color3f inputs:color = (1, 0.91, 0.79)
            float inputs:intensity = 2100
            float3 xformOp:rotateXYZ = (30, -28, -38)
            uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
        }
    }

    over "Cameras"
    {
        def Camera "Overview"
        {
            float2 clippingRange = (0.05, 5000)
            float focalLength = 28
            matrix4d xformOp:transform = ( (0.7405603051369145, 0.6719899065131262, -2.7755575615628914e-17, 0), (-0.25567812390123407, 0.2817677283809519, 0.9247895134577291, -0), (0.6214492186927787, -0.6848624042736745, 0.38047911348537466, 0), (48.99999999999999, -53.99999999999999, 40, 0.9999999999999999) )
            uniform token[] xformOpOrder = ["xformOp:transform"]
        }
    }

    over "Looks"
    {
        over "clear_laminated_glass"
        {
            custom string omni:simready:nonvisual:attributes = "none"
            custom string omni:simready:nonvisual:base = "clear_glass"
            custom string omni:simready:nonvisual:coating = "none"
            token outputs:mdl:surface.connect = </World/Looks/clear_laminated_glass/ELEVEN_OmniGlass.outputs:out>

            def Shader "ELEVEN_OmniGlass"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniGlass.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniGlass"
                float inputs:depth = 0.1
                float inputs:frosting_roughness = 0.025
                color3f inputs:glass_color = (0.97, 0.995, 0.99)
                float inputs:glass_ior = 1.46
                bool inputs:thin_walled = 0
                token outputs:out
            }
        }

