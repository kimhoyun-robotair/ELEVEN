(
    defaultPrim = "Robot"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    timeCodesPerSecond = 120
    upAxis = "Z"
)

def Xform "Robot" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
    customData = {
        double emptyMassKg = 100
        double maxLinearSpeedMps = 2
