        {
            token outputs:surface.connect = </Robot/Looks/shell/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.59, 0.63, 0.66)
                float inputs:metallic = 0.05
                float inputs:roughness = 0.28
