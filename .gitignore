.runtime/
build/
install/
log/
__pycache__/
*.py[cod]
*.egg-info/
*.bag
*.db3
*.mcap

**/*.blend1

# Local validation and recordings; keep the README previews.
/docs/validation/
/docs/VALIDATION.md
/docs/*.png
/docs/*.gif
/docs/*.mp4
!/docs/amr-360.gif
!/docs/locomanipulator-360.gif
!/docs/scout-360.gif
!/docs/scout-creeper-360.gif

# Local Blender source files; exported runtime assets are distributed.
/assets/robot/components/*.blend
!/assets/robot/components/scout_creeper_face.blend

# Only the parallel-gripper description is used by the current robots.
/src/nero_description/urdf/*
!/src/nero_description/urdf/nero_with_gripper_description.urdf
/src/nero_description/meshes/revo2/
/src/nero_description/meshes/revo2_flange.stl
/src/nero_description/meshes/dae/revo2_flange.dae
