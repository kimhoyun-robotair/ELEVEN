        def Cube "Visual" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
            rel material:binding = </World/Looks/floor>
            color3f[] primvars:displayColor = [(0.26, 0.29, 0.32)]
            double size = 1
            float3 xformOp:scale = (12, 10, 0.1)
            double3 xformOp:translate = (0, 0, -0.05)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Plane "CollisionPlane" (
            prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            rel material:binding = </World/Looks/floor>
            rel material:binding:physics = </World/PhysicsMaterials/body>
            float physxCollision:contactOffset = 0.002
            float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.26, 0.29, 0.32)]
            token visibility = "invisible"
        }
    }

