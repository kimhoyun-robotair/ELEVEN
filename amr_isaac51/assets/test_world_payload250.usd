    def Xform "Robot" (
        prepend references = @./robot.usd@
    )
    {
        over "base_link"
        {
            point3f physics:centerOfMass = (0, 0, 0.14683735)
            float3 physics:diagonalInertia = (8.335946, 12.490279, 14.1562)
            float physics:mass = 332

            def Cube "Payload" (
                active = true
                prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
            )
            {
                float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
                rel material:binding = </World/Robot/Looks/payload>
                rel material:binding:physics = </World/Robot/PhysicsMaterials/body>
