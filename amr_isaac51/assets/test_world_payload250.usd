#usda 1.0
(
    defaultPrim = "World"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    timeCodesPerSecond = 120
    upAxis = "Z"
)

def Xform "World"
{
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Scope "Looks"
    {
        def Material "shell"
        {
            token outputs:surface.connect = </World/Looks/shell/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.59, 0.63, 0.66)
                float inputs:metallic = 0.05
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }

        def Material "panel"
        {
            token outputs:surface.connect = </World/Looks/panel/Shader.outputs:surface>

